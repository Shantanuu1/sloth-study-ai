# Copy this file to .env (or set these in PowerShell with $env:NAME = "value").
# Values set in the terminal take priority over .env.

# REQUIRED: the exact Gemma 4 tag shown by `ollama list`.
# The smallest local Gemma 4 tag on ollama.com/library/gemma4 is gemma4:e2b-it-qat (about 4.3 GB).
# Cloud tags (anything containing "cloud") are blocked because they would send notes off your laptop.
OLLAMA_MODEL=gemma4:e2b-it-qat

# Ollama's local address. Must be 127.0.0.1 / localhost (127.0.0.1 is faster on Windows).
OLLAMA_URL=http://127.0.0.1:11434

# Seconds to wait for Gemma before giving up (slow laptops may need more).
OLLAMA_TIMEOUT=600

# Context window in tokens. Lower uses less RAM; 8192 fits the default note limit.
OLLAMA_NUM_CTX=8192

# Longest notes (in characters) sent to the model. Longer files are trimmed.
MAX_NOTE_CHARS=12000

# Port for the website (http://127.0.0.1:5000).
PORT=5000
